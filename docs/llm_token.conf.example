# 复制为 /etc/nginx/secrets/llm_token.conf 并填入真实令牌
#   mkdir -p /etc/nginx/secrets
#   cp llm_token.conf.example /etc/nginx/secrets/llm_token.conf
#   chmod 600 /etc/nginx/secrets/llm_token.conf
#
# 注意：
# 1. 真实令牌文件不要提交到 git
# 2. 该文件被 llm-proxy.conf 的 server 块 include，只能写 set 指令
# 3. 不要放进 /etc/nginx/conf.d/，否则会被 http 块自动加载，set 出现在 http 层会导致 nginx -t 报错

set $llm_token "sk-REPLACE_ME";
